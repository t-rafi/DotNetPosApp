<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>

    <link href="~/twitter-bootstrap/css/bootstrap.min.css" rel="stylesheet" />
</head>

<body class="bg-light">

    <!-- TOP NAVBAR -->
    <nav class="navbar navbar-dark bg-dark fixed-top">
        <div class="container-fluid">

            <a class="navbar-brand fw-bold text-warning">
                💳 POS Admin
            </a>

            <form class="d-flex">
                <input class="form-control me-2 rounded-pill"
                       type="search"
                       placeholder="Search..." />

                <button class="btn btn-warning rounded-pill">
                    Search
                </button>

            </form>

        </div>
    </nav>

    <div class="container-fluid">
        <div class="row">

            <!-- SIDEBAR -->
            <div class="col-md-2 bg-dark text-white min-vh-100 pt-5">

                <ul class="nav flex-column mt-3">

                    <li class="nav-item">
                        <a class="nav-link text-white"
                           asp-controller="Home"
                           asp-action="Index">
                            🏠 Dashboard
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link text-white"
                           asp-controller="Product"
                           asp-action="Index">
                            📦 Products
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link text-white"
                           asp-controller="Category"
                           asp-action="Index">
                            🗂 Categories
                        </a>
                    </li>

                </ul>

            </div>

            <!-- MAIN CONTENT -->
            <div class="col-md-10 pt-5 mt-3">
                @RenderBody()
            </div>

        </div>
    </div>

    <script src="~/twitter-bootstrap/js/bootstrap.min.js"></script>

</body>
</html>
